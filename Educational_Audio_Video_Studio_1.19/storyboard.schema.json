{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio-video-studio/schemas/storyboard-1.3.schema.json",
  "title": "Educational Video Storyboard JSON v1.3 – Optional media with renderable 3D fallback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "learning_analysis",
    "source_segments",
    "assets",
    "scenes",
    "alignment",
    "render"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_language",
        "display_language",
        "aspect_ratio",
        "visual_style"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_language": {
          "type": "string"
        },
        "display_language": {
          "type": "string"
        },
        "target_audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "1:1",
            "4:5"
          ]
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "visual_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description",
            "palette"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "palette": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "minItems": 1
            },
            "font_mood": {
              "type": [
                "string",
                "null"
              ]
            },
            "consistency_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "allow_external_facts": {
          "type": "boolean",
          "default": false
        },
        "audio_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "learning_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "learning_objectives",
        "key_concepts",
        "relationships",
        "summary"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "audience_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept_id",
              "name",
              "explanation",
              "source_segment_ids"
            ],
            "properties": {
              "concept_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "source_segment_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_concept_id",
              "relation",
              "to_concept_id"
            ],
            "properties": {
              "from_concept_id": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              },
              "to_concept_id": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "text",
          "start_s",
          "end_s",
          "timing_origin"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "end_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "timing_origin": {
            "enum": [
              "provided_script_timestamp",
              "estimated_from_order",
              "unknown"
            ]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_type",
          "source",
          "description",
          "search_query"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "asset_type": {
            "enum": [
              "photo",
              "video",
              "illustration",
              "graphic",
              "icon",
              "diagram",
              "chart"
            ]
          },
          "source": {
            "enum": [
              "stock_search",
              "user_media",
              "generated_svg",
              "builtin_graphic",
              "to_be_created"
            ]
          },
          "description": {
            "type": "string"
          },
          "search_query": {
            "type": [
              "string",
              "null"
            ]
          },
          "must_show": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "download_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Direct downloadable file URL, not a webpage URL."
          },
          "source_page_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Original source page for attribution and license context."
          },
          "fallback_download_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Alternative direct media URLs if the primary link fails."
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "creator": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "web_verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_page_opened",
              "direct_file_opened",
              "visual_match_confirmed",
              "license_checked",
              "verified_content_type",
              "verification_note"
            ],
            "properties": {
              "source_page_opened": {
                "const": true
              },
              "direct_file_opened": {
                "const": true
              },
              "visual_match_confirmed": {
                "const": true
              },
              "license_checked": {
                "const": true
              },
              "verified_content_type": {
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/webp",
                  "image/gif",
                  "image/bmp",
                  "video/mp4",
                  "video/webm",
                  "video/quicktime",
                  "video/x-matroska",
                  "video/x-msvideo",
                  "video/mpeg"
                ]
              },
              "verification_note": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "stock_search"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {
              "required": [
                "download_url",
                "source_page_url",
                "fallback_download_urls",
                "provider",
                "creator",
                "license_name",
                "license_url",
                "attribution",
                "web_verification"
              ],
              "properties": {
                "download_url": {
                  "type": "string",
                  "format": "uri",
                  "minLength": 12
                },
                "source_page_url": {
                  "type": "string",
                  "format": "uri",
                  "minLength": 12
                },
                "fallback_download_urls": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  },
                  "maxItems": 3
                },
                "provider": {
                  "type": "string",
                  "minLength": 2
                },
                "creator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "license_name": {
                  "type": "string",
                  "minLength": 2
                },
                "license_url": {
                  "type": "string",
                  "format": "uri",
                  "minLength": 12
                },
                "attribution": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          }
        ]
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "scene_type",
          "learning_goal",
          "segment_ids",
          "provisional_start_s",
          "provisional_end_s",
          "timing_status",
          "visual_summary",
          "layout",
          "asset_ids",
          "elements",
          "transition_in",
          "visual_fallback"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "scene_type": {
            "enum": [
              "title_card",
              "definition",
              "example",
              "scenario",
              "process",
              "comparison",
              "timeline",
              "cause_effect",
              "diagram",
              "chart",
              "quiz",
              "summary",
              "call_to_action",
              "other"
            ]
          },
          "learning_goal": {
            "type": "string"
          },
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "provisional_start_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "provisional_end_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "timing_status": {
            "const": "provisional"
          },
          "visual_summary": {
            "type": "string"
          },
          "layout": {
            "enum": [
              "hero_illustration",
              "title_and_subtitle",
              "two_column",
              "three_column",
              "process_flow",
              "comparison_cards",
              "timeline",
              "staircase",
              "full_screen_diagram",
              "quiz_card",
              "summary_grid",
              "custom"
            ]
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "element_id",
                "kind",
                "content",
                "asset_id",
                "sync_anchor",
                "position",
                "style",
                "animation"
              ],
              "properties": {
                "element_id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "text",
                    "image",
                    "video",
                    "shape",
                    "arrow",
                    "diagram_node",
                    "chart",
                    "icon"
                  ]
                },
                "content": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "asset_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sync_anchor": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment_id",
                    "anchor_type",
                    "quote"
                  ],
                  "properties": {
                    "segment_id": {
                      "type": "string"
                    },
                    "anchor_type": {
                      "enum": [
                        "segment",
                        "sentence",
                        "phrase"
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "description": "Exact substring of the referenced source segment; empty only for whole-segment anchoring."
                    }
                  }
                },
                "position": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "color",
                    "size_role",
                    "weight"
                  ],
                  "properties": {
                    "color": {
                      "type": "string"
                    },
                    "size_role": {
                      "enum": [
                        "display",
                        "headline",
                        "body",
                        "caption",
                        "label"
                      ]
                    },
                    "weight": {
                      "enum": [
                        "regular",
                        "medium",
                        "bold",
                        "black"
                      ]
                    },
                    "alignment": {
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    },
                    "text_effect": {
                      "enum": [
                        "none",
                        "pill",
                        "card",
                        "outline",
                        "glow"
                      ]
                    },
                    "background_color": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "font_scale": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 2.5
                    }
                  }
                },
                "animation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "in",
                    "out",
                    "duration_s"
                  ],
                  "properties": {
                    "in": {
                      "enum": [
                        "none",
                        "fade",
                        "fade_up",
                        "slide_left",
                        "slide_right",
                        "scale_in",
                        "reveal",
                        "draw_path",
                        "highlight",
                        "wipe"
                      ]
                    },
                    "out": {
                      "enum": [
                        "none",
                        "fade",
                        "slide",
                        "scale_out",
                        "wipe"
                      ]
                    },
                    "duration_s": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "image",
                          "video"
                        ]
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "asset_id"
                    ],
                    "properties": {
                      "asset_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "transition_in": {
            "enum": [
              "cut",
              "fade",
              "dissolve",
              "slide",
              "wipe",
              "none"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "visual_fallback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "background",
              "objects",
              "connectors"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "3d_illustration",
                  "infographic",
                  "typography",
                  "flowchart",
                  "mixed"
                ]
              },
              "background": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "primary",
                  "secondary",
                  "accent",
                  "pattern"
                ],
                "properties": {
                  "primary": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "secondary": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "pattern": {
                    "enum": [
                      "grid",
                      "dots",
                      "soft_glow",
                      "plain",
                      "blueprint"
                    ]
                  }
                }
              },
              "objects": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "object_id",
                    "shape",
                    "position",
                    "color",
                    "label",
                    "animation"
                  ],
                  "properties": {
                    "object_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "shape": {
                      "enum": [
                        "cube",
                        "cuboid",
                        "sphere",
                        "cylinder",
                        "cone",
                        "pyramid",
                        "staircase",
                        "plant",
                        "person",
                        "cup",
                        "book",
                        "sun",
                        "leaf",
                        "speech_bubble",
                        "card",
                        "molecule",
                        "light_bulb",
                        "globe",
                        "monitor",
                        "phone",
                        "atom",
                        "magnifier",
                        "arrow3d",
                        "eye",
                        "calendar",
                        "photo_album",
                        "thought_bubble",
                        "bird",
                        "clock",
                        "checkmark",
                        "x_mark"
                      ]
                    },
                    "position": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 0.74
                        },
                        "width": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        },
                        "height": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 0.72
                        }
                      }
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "secondary_color": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "detail": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "depth": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "variant": {
                      "enum": [
                        "solid",
                        "wireframe",
                        "glass",
                        "soft",
                        "outlined"
                      ]
                    },
                    "animation": {
                      "enum": [
                        "none",
                        "float",
                        "pulse",
                        "rotate",
                        "draw_in",
                        "rise",
                        "glow"
                      ]
                    }
                  }
                }
              },
              "connectors": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from_object",
                    "to_object",
                    "label",
                    "style",
                    "color"
                  ],
                  "properties": {
                    "from_object": {
                      "type": "string"
                    },
                    "to_object": {
                      "type": "string"
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "style": {
                      "enum": [
                        "arrow",
                        "line",
                        "dashed",
                        "curved_arrow"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    }
                  }
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "word_level_timestamps_available",
        "replace_provisional_times_after_alignment"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "method": {
          "const": "forced_alignment"
        },
        "word_level_timestamps_available": {
          "const": false
        },
        "replace_provisional_times_after_alignment": {
          "const": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "resolution",
        "fps",
        "background_policy",
        "subtitle_policy"
      ],
      "properties": {
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "1:1",
            "4:5"
          ]
        },
        "resolution": {
          "enum": [
            "1080x1920",
            "1920x1080",
            "1080x1080",
            "1080x1350"
          ]
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "background_policy": {
          "enum": [
            "fit",
            "fill_crop",
            "blur_fill"
          ]
        },
        "subtitle_policy": {
          "enum": [
            "key_phrases_only",
            "full_sentence",
            "no_subtitles",
            "bilingual"
          ]
        },
        "audio_source": {
          "const": "provided_audio"
        }
      }
    }
  },
